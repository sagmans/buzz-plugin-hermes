{
  "//": "Type check of src/ with the buzz-app clone at the pinned revision (the buzz-app link, scripts/build-plugin.mjs). Same strict options as buzz-app, so its modules type-check here as they do there.",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "typeRoots": ["./buzz-app/node_modules/@types", "./buzz-app/node_modules"],
    "types": ["vite/client", "node"],
    "paths": {
      "@app/*": ["./buzz-app/src/*"],
      "react": ["./buzz-app/node_modules/@types/react"],
      "@deepseek-ai/cordis": ["./buzz-app/node_modules/@deepseek-ai/cordis"]
    }
  },
  "include": [
    "src",
    "buzz-app/src/plugins/api.ts",
    "buzz-app/src/shared/design-system/icons/tabler.d.ts"
  ]
}
