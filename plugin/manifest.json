{
  "id": "sagmans.hermes",
  "name": "Hermes",
  "apiVersion": 1,
  "description": "Run local Hermes Agent agents in Buzz. Each conversation is one Hermes ACP session on this computer, with the provider and model that Hermes is set up with.",
  "discovery": {
    "category": "agents",
    "tags": ["code", "coding-agents", "Hermes"]
  },
  "host": {
    "processes": [
      { "id": "hermes", "program": "hermes", "args": ["acp"] },
      {
        "id": "hermes-usage",
        "program": "hermes",
        "args": [
          "sessions",
          "export",
          "--format",
          "jsonl",
          "--source",
          "local",
          "--newer-than",
          "30d",
          "-"
        ]
      }
    ],
    "mcp": true,
    "files": true
  }
}
